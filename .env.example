# SentinelOps AI - Environment Configuration Example
# Copy this file to .env for local overrides (never commit actual secrets)

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="SentinelOps AI"
VERSION="1.0.0"
LOG_LEVEL=INFO

# Database Connection (Defaults to local SQLite fallback)
# For local SQLite: sqlite:///./sentinelops.db
# For PostgreSQL: postgresql+psycopg2://sentinel:sentinel_pass@localhost:5432/sentinelops
DATABASE_URL=sqlite:///./sentinelops.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# AI Engine Mode: LOCAL_DETERMINISTIC or EXTERNAL_LLM
AI_INVESTIGATION_MODE=LOCAL_DETERMINISTIC

# Optional External LLM Key (leave empty to use deterministic local engine)
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Seed for reproducible synthetic IT data generation
DATA_SEED=42
